# Telegram Bot Utility - environment configuration template
# Copy this file to `.env` and fill in your own values.

# --- Required for the Dumper (mode 4) ---
# Get your credentials from https://my.telegram.org
API_ID=
API_HASH=

# --- Optional convenience ---
# Bot token from @BotFather. When set, the CLI uses it automatically
# (no need to type the token every time).
BOT_TOKEN=

# --- Network (optional) ---
REQUEST_TIMEOUT=30
RETRY_COUNT=3
RETRY_BACKOFF=1.5
# Max media size in bytes (default 50 MB)
MEDIA_MAX_SIZE=52428800

# --- History dumping (optional) ---
# Messages fetched per cycle
HISTORY_DUMP_STEP=100
# Empty batches tolerated before assuming history end (handles deleted messages)
LOOKAHEAD_STEP_COUNT=3

# --- Zip archiving & forwarding (optional) ---
ZIP_INTERVAL_MESSAGES=50
ZIP_INTERVAL_SECONDS=300
ZIP_CLEANUP_AFTER_SEND=true

# --- Logging (optional) ---
LOG_LEVEL=INFO
LOG_FILE=telegram_bot_utility.log
LOG_FILE_ENABLED=true
